# Порт моста (Diplom указывает PARTNER_API_URL на этот адрес)
DIPLOM_BRIDGE_PORT=4010

# Основной API партнёрского сайта (backend)
# Локально:
MAIN_API_URL=http://localhost:4000
# Production (kabantable.space) — см. .env.production.example

# MongoDB — та же БД, что у backend (для join/elevate без правок основного кода)
MONGODB_URI=mongodb://localhost:27017/dndtable

# Служебный пользователь (создаётся: npm -w backend run seed:support-bot)
SERVICE_EMAIL=aisuppurt@bot.bot.bot
SERVICE_PASSWORD=UltraSekretusBotusParolus

# Опционально: секрет для запросов от Diplom (заголовок X-Diplom-Bridge-Key)
# DIPLOM_BRIDGE_API_KEY=

# После patch/full автоматически снимать бота с сессии (рекомендуется true)
AUTO_LEAVE_AFTER_REQUEST=true
