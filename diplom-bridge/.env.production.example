# Скопируйте на сервере партнёра:
#   cp .env.production.example .env
#
# ВАЖНО: MAIN_API_URL не должен быть http://localhost:4000 в production —
# backend отдаёт cookie с флагом Secure, и мост не сможет сохранить сессию по HTTP.

DIPLOM_BRIDGE_PORT=4010
DIPLOM_BRIDGE_BIND=0.0.0.0

# Публичный URL основного API (тот же домен, что у сайта)
MAIN_API_URL=https://kabantable.space

# MongoDB — та же строка, что в backend/.env (можно скопировать MONGODB_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/dndtable

SERVICE_EMAIL=aisuppurt@bot.bot.bot
SERVICE_PASSWORD=UltraSekretusBotusParolus

# Опционально: секрет для запросов от Diplom (заголовок X-Diplom-Bridge-Key)
# DIPLOM_BRIDGE_API_KEY=

AUTO_LEAVE_AFTER_REQUEST=true
