# Production frontend build — copy to frontend/.env before npm run build
#
# Same-origin (recommended with Nginx or SERVE_STATIC=true):
#   leave both variables empty — API and Socket.IO use the current host
#
# Split domains (not recommended without extra cookie config):
#   VITE_API_BASE=https://api.yourdomain.com
#   VITE_SOCKET_URL=https://api.yourdomain.com

VITE_API_BASE=
VITE_SOCKET_URL=
