# Nginx — этап 1: только HTTP (ДО certbot).
# 1. Замените YOUR_DOMAIN на ваш домен (например dnd.example.com).
# 2. sudo cp ... /etc/nginx/sites-available/dndtable
# 3. sudo nginx -t && sudo systemctl reload nginx
# 4. sudo certbot --nginx -d YOUR_DOMAIN   ← certbot сам добавит HTTPS

server {
    listen 80;
    server_name YOUR_DOMAIN;

    root /opt/dndtable/frontend/dist;
    index index.html;

    client_max_body_size 10M;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ ^/(auth|api|health|avatars) {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /socket.io/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }
}
