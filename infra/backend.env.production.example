# Production — copy to backend/.env on the server
NODE_ENV=production
PORT=4000

# MongoDB Atlas or self-hosted instance
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dndtable?retryWrites=true&w=majority

# Public site URL (must match the browser origin, no trailing slash)
SOCKET_CORS_ORIGIN=https://yourdomain.com

# Generate: openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
SESSION_COOKIE_NAME=dnd.sid
SESSION_MAX_AGE_MS=604800000

ASSETS_DIR=./assets_data

# VPS + Nginx: false (Nginx serves frontend/dist)
# Docker / PaaS single service: true
SERVE_STATIC=false

# Enabled automatically when NODE_ENV=production; set explicitly if needed
TRUST_PROXY=1
