# Development defaults — copy to backend/.env
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/dndtable
ASSETS_DIR=./assets_data
SOCKET_CORS_ORIGIN=http://localhost:5173

SESSION_SECRET=change_me_session_secret
SESSION_COOKIE_NAME=dnd.sid
SESSION_MAX_AGE_MS=604800000

# Behind Nginx / reverse proxy in production (auto-enabled when NODE_ENV=production)
TRUST_PROXY=0

# Serve frontend/dist from Express (use true for Docker / PaaS single-service deploy)
SERVE_STATIC=false

# Optional override for frontend build output path
# STATIC_DIR=../../frontend/dist
